# Desenvolvimento local: use /api com proxy do Vite para manter a sessao same-origin.
# Em producao na Vercel, /api tambem passa pelo proxy serverless em FRONTEND/api/[...path].ts.
# Configure BACKEND_PROXY_TARGET se a URL do backend for diferente do default.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:3333
BACKEND_PROXY_TARGET=https://jamval-app-backend.vercel.app
