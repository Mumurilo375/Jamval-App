# Docker dev compose variables
COMPOSE_PROJECT_NAME=jamval-dev

# Images
NODE_IMAGE=node:20-bookworm-slim
POSTGRES_IMAGE=postgres:16-alpine

# Ports
BACKEND_PORT=3333
FRONTEND_PORT=5173
POSTGRES_PORT=5432

# Backend runtime
NODE_ENV=development
BACKEND_HOST=0.0.0.0
LOG_LEVEL=info
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_NAME=jamval_session
CORS_ORIGIN=

# Database
DB_SYNC=true
DB_NAME=jamval
DB_USER=jamval
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_LOGGING=false
STORAGE_ROOT=

# Frontend runtime
FRONTEND_HOST=0.0.0.0
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://backend:3333
